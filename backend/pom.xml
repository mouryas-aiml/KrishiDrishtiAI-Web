<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.1</version>
    <relativePath/>
  </parent>
  <groupId>com.krishidrishti</groupId>
  <artifactId>krishi-drishti-api</artifactId>
  <version>1.0.0</version>
  <properties>
    <java.version>21</java.version>
    <onnxruntime.version>1.20.0</onnxruntime.version>
  </properties>
  <dependencies>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-jpa</artifactId></dependency>
    <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>com.microsoft.onnxruntime</groupId><artifactId>onnxruntime</artifactId><version>${onnxruntime.version}</version></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>add-tensorflow-lite-classes</id>
            <phase>generate-sources</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <mkdir dir="${project.build.directory}/tensorflow-lite"/>
                <get src="https://repo1.maven.org/maven2/org/tensorflow/tensorflow-lite/2.16.1/tensorflow-lite-2.16.1.aar" dest="${project.build.directory}/tensorflow-lite/tensorflow-lite.aar" usetimestamp="true"/>
                <get src="https://repo1.maven.org/maven2/org/tensorflow/tensorflow-lite-api/2.16.1/tensorflow-lite-api-2.16.1.aar" dest="${project.build.directory}/tensorflow-lite/tensorflow-lite-api.aar" usetimestamp="true"/>
                <unzip src="${project.build.directory}/tensorflow-lite/tensorflow-lite.aar" dest="${project.build.directory}/tensorflow-lite"/>
                <unzip src="${project.build.directory}/tensorflow-lite/tensorflow-lite-api.aar" dest="${project.build.directory}/tensorflow-lite-api"/>
                <unzip src="${project.build.directory}/tensorflow-lite-api/classes.jar" dest="${project.build.outputDirectory}"/>
                <unzip src="${project.build.directory}/tensorflow-lite/classes.jar" dest="${project.build.outputDirectory}"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
