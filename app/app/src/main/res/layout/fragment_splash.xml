<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/colorPrimary"
    android:padding="24dp"
    tools:context=".SplashFragment">

    <ImageView
        android:id="@+id/centerImage"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_krishi_drishti_logo"
        android:contentDescription="Krishi Drishti Logo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="KRISHI DRISHTI"
        android:textColor="@color/colorWhite"
        android:textSize="28sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:layout_marginTop="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="An Intelligent AI Crop Health Platform"
        android:textColor="#C8E6C9"
        android:textSize="14sp"
        android:layout_marginTop="6dp" />

</LinearLayout>
