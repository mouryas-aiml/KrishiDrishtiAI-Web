<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnBackAssistant"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_menu_send"
            android:rotation="180"
            app:tint="@color/colorWhite"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Crop Assistant"
                android:textColor="@color/colorWhite"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Krishi Drishti • Online &amp; Offline"
                android:textColor="#C8E6C9"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_krishi_drishti_logo" />
    </LinearLayout>

    <!-- Chat Messages Scroll Container -->
    <ScrollView
        android:id="@+id/chatScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/chatContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Welcome Message Bubble -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/colorWhite"
                android:padding="14dp"
                android:layout_marginBottom="12dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🤖 Krishi Drishti AI Assistant"
                    android:textColor="@color/colorPrimary"
                    android:textStyle="bold"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Namaste Farmer! How can I help you today? You can ask about crop diseases, organic treatments, fertilizer timing, or disease prevention for Apple, Tomato, Potato, Corn, Cotton and more."
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Quick Prompt Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chip1"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🍂 Early Blight Treatment"
                android:textSize="12sp"
                android:textColor="@color/colorPrimary"
                android:background="@color/colorWhite"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/chip2"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🌿 Organic Pest Control"
                android:textSize="12sp"
                android:textColor="@color/colorPrimary"
                android:background="@color/colorWhite"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/chip3"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="⛅ Rainy Season Care"
                android:textSize="12sp"
                android:textColor="@color/colorPrimary"
                android:background="@color/colorWhite" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@color/colorWhite"
        android:gravity="center_vertical"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btnMic"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_menu_camera"
            android:onClick="startVoiceInput"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/colorAccent"
            android:layout_marginEnd="4dp"
            android:contentDescription="Voice Input" />

        <EditText
            android:id="@+id/etQuestion"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="@string/ask_ai_hint"
            android:textSize="14sp"
            android:padding="12dp"
            android:background="@color/colorBackground"
            android:inputType="textCapSentences" />

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_menu_send"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/colorPrimary"
            android:layout_marginStart="8dp"
            android:contentDescription="Send" />
    </LinearLayout>

</LinearLayout>
